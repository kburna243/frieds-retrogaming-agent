{
  "name": "frieds-retrogaming-agent",
  "version": "0.4.0",
  "description": "Agent harness for Fried's Retrogaming Kit: plans, remembers and acts on a retro cabinet exclusively through the Kit API (JSON over stdio).",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "fagent": "dist/bin.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node tools/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test && node tools/check-repo-rules.mjs",
    "lint": "node tools/check-repo-rules.mjs",
    "cli": "node --no-warnings src/cli.ts",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "README.de.md",
    "CHANGELOG.md",
    "LICENSE"
  ]
}
