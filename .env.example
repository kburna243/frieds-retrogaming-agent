# Copy to .env (git-ignored) or set the variables in your shell. Every one of these has a default; the only
# required value is FAGENT_KIT_ROOT, and chat additionally needs a model.

# Where the kit checkout lives. The harness calls <kit>\api\Invoke-KitApi.ps1 and nothing else.
FAGENT_KIT_ROOT=D:\cabinet\frieds-retrogaming-kit

# read-only (default) | operator. No level skips the dry run or the human.
FAGENT_LEVEL=read-only

# Where the SQLite memory lives. Default: %LOCALAPPDATA%\frieds-retrogaming-agent\harness.db
# FAGENT_DB=D:\cabinet\agent-memory\frieds-retrogaming-agent\harness.db

# Kit message language: en-US (default) | de-DE
FAGENT_CULTURE=en-US

# --- model: local, the default -------------------------------------------------
# Anything OpenAI-compatible. Ollama: `ollama list` shows what is really there;
# this harness never pulls a model by itself.
FAGENT_PROVIDER=local
FAGENT_OLLAMA_URL=http://127.0.0.1:11434/v1
FAGENT_MODEL=qwen2.5:3b

# --- model: cloud (last resort) ------------------------------------------------
# Setting this forces -Anonymize on every kit call; it cannot be turned off.
# Prefer a local model: the cabinet works offline, the agent should too.
# FAGENT_PROVIDER=cloud
# FAGENT_CLOUD_BASE_URL=https://api.example.test/v1
# FAGENT_CLOUD_MODEL=some-model
# FAGENT_CLOUD_API_KEY=put-it-in-your-shell-not-in-this-file
