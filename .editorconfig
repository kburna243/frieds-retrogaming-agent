root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.ps1]
# Windows PowerShell 5.1 reads files without a BOM as ANSI; any non-ASCII needs the BOM (kit rule, same here).
end_of_line = crlf

[*.{md,yml,yaml}]
trim_trailing_whitespace = false
